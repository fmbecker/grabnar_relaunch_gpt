---
import type { HeroValue } from "@/lib/types";
import Picture from "@/components/ui/Picture.astro";
import LinkButton from "@/components/ui/LinkButton.astro";
import BrandPattern from "@/components/ui/BrandPattern.astro";
interface Props { value: HeroValue }
const { value } = Astro.props;
---
<section class="on-dark relative overflow-hidden bg-brand-500 text-white">
  <div class="container-x grid gap-10 pt-12 sm:gap-12 sm:pt-16 lg:min-h-[38rem] lg:grid-cols-12 lg:items-stretch lg:gap-10 lg:py-20 xl:gap-16">
    <div class="flex flex-col justify-center lg:col-span-7 lg:py-8">
      {value.motto && (
        <blockquote class="mb-7 max-w-[42ch] border-l-2 border-white/70 pl-4 text-base leading-relaxed italic sm:mb-9 sm:text-lg">„{value.motto}“</blockquote>
      )}
      <h1 class="h1 max-w-[14ch]">{value.headline}</h1>
      {value.subline && <p class="lead mt-7 max-w-[38ch] text-white sm:mt-8">{value.subline}</p>}
      {value.links.length > 0 && (
        <div class="mt-9 flex flex-wrap items-center gap-3 sm:mt-11 sm:gap-4">
          {value.links.map((l) => (
            <LinkButton block="hero" link={l} class={l.style === "secondary" ? "btn-secondary-on-dark" : ""} />
          ))}
        </div>
      )}
    </div>
    <!-- Picture: cut at an angle like the logo's roofs; drawn towers until the company's photos arrive -->
    <div class="relative -mx-4 h-72 overflow-hidden bg-brand-600 [clip-path:polygon(0_12%,100%_0,100%_100%,0_100%)] sm:-mx-6 sm:h-96 lg:col-span-5 lg:mx-0 lg:h-auto lg:min-h-[34rem] lg:[clip-path:polygon(13%_0,100%_0,100%_100%,0_100%)]">
      {value.image ? (
        <Picture image={value.image} variant="hero" loading="eager" sizes="(min-width: 1024px) 42vw, 100vw" class="absolute inset-0 h-full w-full object-cover" />
      ) : (
        <BrandPattern class="absolute inset-0 h-full w-full" />
      )}
    </div>
  </div>
</section>
