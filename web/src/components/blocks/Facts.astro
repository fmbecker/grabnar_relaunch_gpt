---
import type { FactsValue } from "@/lib/types";
interface Props { value: FactsValue }
const { value } = Astro.props;
---
<section aria-label="Auf einen Blick" class="on-dark border-y border-white/10 bg-accent-600 text-white">
  <ul class="container-x grid grid-cols-2 gap-x-5 gap-y-0 py-4 sm:gap-x-8 sm:py-5 lg:flex lg:flex-wrap lg:items-center lg:justify-between lg:gap-x-8 lg:gap-y-3 lg:py-6">
    {value.items.map((item) => (
      <li class="flex min-h-14 items-center border-b border-white/20 py-3 font-display text-sm font-extrabold uppercase leading-snug tracking-wide last:border-b-0 sm:text-base lg:min-h-11 lg:border-b-0 lg:py-2">
        {item}
      </li>
    ))}
  </ul>
</section>
